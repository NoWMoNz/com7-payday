# Google service account (จากไฟล์ JSON ที่ดาวน์โหลดจาก Google Cloud)
GOOGLE_SERVICE_ACCOUNT_EMAIL=gift-check@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Sheet: ID คือส่วนระหว่าง /d/ กับ /edit ในลิงก์ของ Sheet
SHEET_ID=
SHEET_NAME=รายชื่อ

# แท็บที่เก็บผู้ใช้ (คอลัมน์ Username, Name, Password, Role) อยู่ใน Sheet เดียวกับด้านบน
LOGIN_SHEET_NAME=รหัสผ่าน

# (ไม่บังคับ) บัญชีสำรองเผื่ออ่าน Sheet ไม่ได้: username:password:ชื่อที่แสดง คั่นหลายคนด้วย ,
ADMIN_USERS=admin:เปลี่ยนรหัสนี้:แอดมิน,staff2:รหัสอีกชุด:แอดมินคนที่ 2

# สุ่มข้อความยาว ๆ อย่างน้อย 32 ตัว เช่นจาก: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Vercel ใส่ให้เองเมื่อเชื่อม Blob store กับโปรเจกต์
BLOB_READ_WRITE_TOKEN=
